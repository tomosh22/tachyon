# Runs an example with TACHYON_SIDECAR pointing into the build tree and checks that a non-empty sidecar appears.
# Inputs: -DEXE=<path> -DSIDECAR=<path> [-DARGS=<semicolon separated arguments>]
if(NOT EXE OR NOT SIDECAR)
  message(FATAL_ERROR "EXE and SIDECAR are required")
endif()
file(REMOVE "${SIDECAR}")
set(ENV{TACHYON_SIDECAR} "${SIDECAR}")
execute_process(COMMAND "${EXE}" ${ARGS} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
message(STATUS "${out}${err}")
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "${EXE} exited with ${rc}")
endif()
if(NOT EXISTS "${SIDECAR}")
  message(FATAL_ERROR "no sidecar produced at ${SIDECAR}")
endif()
file(SIZE "${SIDECAR}" size)
if(size LESS 100)
  message(FATAL_ERROR "sidecar ${SIDECAR} is too small (${size} bytes)")
endif()
message(STATUS "sidecar ${SIDECAR}: ${size} bytes")
